# Browser-only pilot configuration. Set in the Next deployment/build environment.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_<key>
NEXT_PUBLIC_API_ORIGIN=https://api.<your-domain>

# Must remain absent from every real deployment:
# NEXT_PUBLIC_E2E_AUTH_BRIDGE=

# Never put DATABASE_URL, SUPABASE_JWT_SECRET, SUPABASE_JWKS_URL or
# SUPABASE_SECRET_KEY in this file.
