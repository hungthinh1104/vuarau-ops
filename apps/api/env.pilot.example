# API only — supply through the deployment secret store, never commit a filled copy.
APP_ENV=pilot
PORT=3000
DATABASE_URL=postgresql://<pilot-user>:<password>@<host>:5432/<pilot-database>?sslmode=require
PUBLIC_APP_ORIGIN=https://app.<your-domain>

SUPABASE_JWT_ISSUER=https://<project-ref>.supabase.co/auth/v1
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json

# Must remain absent in pilot mode:
# SUPABASE_JWT_SECRET=
# NEXT_PUBLIC_E2E_AUTH_BRIDGE=
