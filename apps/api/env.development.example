# API only — copy to apps/api/.env for local development. Never expose these to Next.
APP_ENV=development
# Explicit local-only fallback when a real actor row is not provisioned yet.
# Leave unset when testing real subject-to-actor and workspace isolation.
DEV_PRINCIPAL_FALLBACK=1
PORT=3000
DATABASE_URL=postgres://postgres:postgres@localhost:55432/vuarau_test

# Use exactly ONE verification method in development.
SUPABASE_JWT_ISSUER=https://<project-ref>.supabase.co/auth/v1
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWT_SECRET=<development-only-hs256-secret>
# SUPABASE_JWKS_URL=

# Optional locally; required only in pilot mode.
# PUBLIC_APP_ORIGIN=http://localhost:3001
