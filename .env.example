# Copy to `.env` and fill in. Never commit a real `.env`.

# Postgres connection used by migrations, seeds, and the `db` test project.
# When unset, `pnpm test:db` skips its suites instead of failing.
#
# Local Docker container created during bootstrap:
#   docker run -d --name vuanha-dev-pg \
#     -e POSTGRES_PASSWORD=postgres -e POSTGRES_USER=postgres -e POSTGRES_DB=vuanha_test \
#     -p 55432:5432 postgres:17-alpine
DATABASE_URL=postgres://postgres:postgres@localhost:55432/vuanha_test

# Supabase project values. Not required for the current vertical slice — the API
# accepts a resolved actor identity from its caller and does not verify JWTs yet.
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
