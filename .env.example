# Copy to `.env` and fill in. Never commit a real `.env`.

# Postgres connection used by migrations, seeds, and the `db` test project.
# When unset, `pnpm test:db` skips its suites instead of failing.
#
# Local Docker container created during bootstrap:
#   docker run -d --name vuarau-ops-dev-pg \
#     -e POSTGRES_PASSWORD=postgres -e POSTGRES_USER=postgres -e POSTGRES_DB=vuarau_test \
#     -p 55432:5432 postgres:17-alpine
DATABASE_URL=postgres://postgres:postgres@localhost:55432/vuarau_test

# --- Supabase authentication (Milestone 1) -----------------------------------
# The API verifies bearer tokens and resolves `sub` to a local actor. Without
# these the server refuses to start; tests do not need them.
SUPABASE_JWT_ISSUER=https://your-project.supabase.co/auth/v1
SUPABASE_JWT_AUDIENCE=authenticated

# Set exactly ONE of the following.
# Preferred — asymmetric keys, so this server never holds signing material:
# SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json
# Legacy shared secret (HS256). Treat as a credential; never commit a real value:
# SUPABASE_JWT_SECRET=
