{
  "name": "vuarau-ops",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p apps/web/tsconfig.json",
    "test": "vitest run",
    "test:focus": "vitest run",
    "test:related": "vitest related --run",
    "test:changed": "vitest run --changed HEAD",
    "test:domain": "vitest run --project domain",
    "test:application": "vitest run --project application",
    "test:contract": "vitest run --project contract",
    "test:db": "node --env-file-if-exists=.env scripts/test-db.ts",
    "test:watch": "vitest",
    "dev": "node --env-file-if-exists=.env scripts/dev.ts",
    "dev:api": "pnpm --filter @vuarau/api dev",
    "dev:web": "pnpm --filter @vuarau/web dev",
    "context": "node scripts/context.ts",
    "context:test": "node --test scripts/context.test.ts",
    "trace:check:test": "node --test scripts/trace-collector.test.ts",
    "test:architecture": "node --test scripts/test-architecture.test.ts && node scripts/test-architecture.ts",
    "coverage:report": "vitest run --coverage --coverage.reporter=text --coverage.reporter=json-summary --coverage.reporter=json",
    "coverage:changed": "pnpm coverage:report && node scripts/coverage-check.ts",
    "e2e:config:test": "node --test apps/web/e2e/harness/environment.test.ts apps/web/e2e/harness/projects.test.ts",
    "dev:environment:test": "node --test scripts/dev-environment.test.ts",
    "test:fast": "vitest run --project domain --project application --project contract --project web",
    "test:release": "vitest run --project domain --project application --project contract --project web && pnpm test:db",
    "validate:commit": "pnpm check:static && pnpm test:fast",
    "check:static": "pnpm format && pnpm lint && pnpm typecheck && pnpm boundary:check && pnpm source:check && pnpm ui:check && pnpm docs:check && pnpm docs:check:test && pnpm docs:governance:test && pnpm command-registry:test && pnpm release:manifest:test && pnpm truth:check && pnpm context:test && pnpm e2e:config:test && pnpm dev:environment:test && pnpm pilot:dry-run:test && pnpm synthetic:depot-day:test && pnpm web:e2e:test && pnpm policy:closure:test && pnpm field:observation:test && pnpm trace:check:test && pnpm test:architecture && pnpm trace:check && pnpm docs:governance && pnpm command-registry:check && pnpm security:surface && node --test scripts/db-generate-check.test.ts scripts/verify-release.test.ts",
    "boundary:check": "node scripts/boundary-check.ts",
    "source:check": "node --test scripts/source-boundary-check.test.ts && node scripts/source-boundary-check.ts",
    "ui:check": "node --test scripts/ui-architecture-check.test.ts && node scripts/ui-architecture-check-runner.ts",
    "trace:check": "node scripts/trace-check.ts",
    "docs:check": "node scripts/docs-check.ts",
    "docs:governance": "node scripts/documentation-governance-check.ts",
    "docs:governance:test": "node --test scripts/documentation-governance-check.test.ts",
    "command-registry:check": "node scripts/command-registry-check.ts",
    "command-registry:test": "node --test scripts/command-registry-check.test.ts",
    "release:manifest": "node scripts/release-manifest.ts",
    "release:manifest:test": "node --test scripts/release-manifest.test.ts",
    "docs:check:test": "node --test scripts/docs-check.test.ts",
    "db:generate": "pnpm --filter @vuarau/db db:generate",
    "db:generate:check": "node scripts/db-generate-check.ts",
    "db:migrate": "pnpm --filter @vuarau/db db:migrate",
    "db:seed": "pnpm --filter @vuarau/db db:seed",
    "perf:production-scale": "node --env-file-if-exists=.env packages/db/src/performance/production-scale-rehearsal.ts",
    "security:surface": "node scripts/security-surface-check.ts",
    "rehearse:migrations": "node --env-file-if-exists=.env packages/db/src/performance/migration-rehearsal.ts",
    "verify:production-hardening": "pnpm security:surface && pnpm perf:production-scale && pnpm rehearse:migrations",
    "pilot:dry-run": "node --env-file-if-exists=.env scripts/pilot-dry-run.ts",
    "pilot:dry-run:test": "node --test scripts/pilot-dry-run.test.ts",
    "synthetic:depot-day": "node --env-file-if-exists=.env scripts/synthetic-depot-day.ts",
    "synthetic:depot-day:test": "node --test scripts/synthetic-depot-day.test.ts",
    "web:e2e:test": "node --test scripts/web-e2e.test.ts",
    "policy:closure": "node scripts/policy-closure.ts",
    "policy:closure:test": "node --test scripts/policy-closure.test.ts",
    "field:observation": "node scripts/field-observation.ts",
    "field:observation:test": "node --test scripts/field-observation.test.ts",
    "verify": "pnpm check:static && pnpm test && pnpm web:build && pnpm web:storybook && pnpm web:e2e:build && pnpm web:e2e",
    "verify:release": "node scripts/verify-release.ts",
    "web:build": "pnpm --filter @vuarau/web build",
    "web:e2e:build": "NEXT_DIST_DIR=.next-e2e NEXT_PUBLIC_E2E_AUTH_BRIDGE=1 NEXT_PUBLIC_API_ORIGIN=http://127.0.0.1:${E2E_API_PORT:-3102} NEXT_PUBLIC_SUPABASE_URL= NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY= NEXT_PUBLIC_SUPABASE_ANON_KEY= pnpm --filter @vuarau/web build",
    "web:storybook": "pnpm --filter @vuarau/web storybook:build",
    "test:web": "vitest run --project web",
    "web:e2e": "node --env-file-if-exists=.env scripts/web-e2e.ts",
    "truth:check": "node scripts/repository-truth-check.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "3.2.7",
    "eslint": "^9.39.1",
    "globals": "^17.7.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4",
    "vitest": "^3.2.4",
    "yaml": "^2.8.1",
    "zod": "^4.4.3"
  }
}
