{
  "name": "vuarau-ops",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p apps/web/tsconfig.json",
    "test": "vitest run",
    "test:focus": "vitest run",
    "test:related": "vitest related --run",
    "test:changed": "vitest run --changed HEAD",
    "test:domain": "vitest run --project domain",
    "test:application": "vitest run --project application",
    "test:contract": "vitest run --project contract",
    "test:db": "vitest run --project db",
    "test:watch": "vitest",
    "dev": "node --env-file-if-exists=.env scripts/dev.ts",
    "dev:api": "pnpm --filter @vuarau/api dev",
    "dev:web": "pnpm --filter @vuarau/web dev",
    "context": "node scripts/context.ts",
    "context:test": "node --test scripts/context.test.ts",
    "test:fast": "vitest run --project domain --project application --project contract --project web",
    "validate:commit": "pnpm check:static && pnpm test:fast",
    "check:static": "pnpm format && pnpm lint && pnpm typecheck && pnpm boundary:check && pnpm source:check && pnpm ui:check && pnpm docs:check && pnpm docs:check:test && pnpm truth:check && pnpm context:test && pnpm trace:check && pnpm security:m22",
    "boundary:check": "node scripts/boundary-check.ts",
    "source:check": "node --test scripts/source-boundary-check.test.ts && node scripts/source-boundary-check.ts",
    "ui:check": "node --test scripts/ui-architecture-check.test.ts && node scripts/ui-architecture-check-runner.ts",
    "trace:check": "node scripts/trace-check.ts",
    "docs:check": "node scripts/docs-check.ts",
    "docs:check:test": "node --test scripts/docs-check.test.ts",
    "db:generate": "pnpm --filter @vuarau/db db:generate",
    "db:migrate": "pnpm --filter @vuarau/db db:migrate",
    "db:seed": "pnpm --filter @vuarau/db db:seed",
    "perf:m22": "node --env-file-if-exists=.env packages/db/src/performance/m22-scale.ts",
    "security:m22": "node scripts/m22-security-check.ts",
    "rehearse:m22": "node --env-file-if-exists=.env packages/db/src/performance/m22-migration-rehearsal.ts",
    "verify:m22": "pnpm security:m22 && pnpm perf:m22 && pnpm rehearse:m22",
    "pilot:dry-run": "node --env-file-if-exists=.env scripts/m23-pilot-dry-run.ts",
    "verify": "pnpm check:static && pnpm test && pnpm web:build && pnpm web:storybook && pnpm web:e2e",
    "web:build": "pnpm --filter @vuarau/web build",
    "web:e2e:build": "NEXT_DIST_DIR=.next-e2e NEXT_PUBLIC_E2E_AUTH_BRIDGE=1 NEXT_PUBLIC_API_ORIGIN=http://127.0.0.1:3102 NEXT_PUBLIC_SUPABASE_URL= NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY= NEXT_PUBLIC_SUPABASE_ANON_KEY= pnpm --filter @vuarau/web build",
    "web:storybook": "pnpm --filter @vuarau/web storybook:build",
    "test:web": "vitest run --project web",
    "web:e2e": "pnpm --filter @vuarau/web e2e",
    "truth:check": "node scripts/repository-truth-check.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9.39.1",
    "globals": "^17.7.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4",
    "vitest": "^3.2.4",
    "yaml": "^2.8.1"
  }
}
