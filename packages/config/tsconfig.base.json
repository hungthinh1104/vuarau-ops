{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "moduleDetection": "force",

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noPropertyAccessFromIndexSignature": true,
    "useUnknownInCatchVariables": true,
    "verbatimModuleSyntax": true,

    /*
     * Relative imports carry explicit `.ts` extensions. Node 24 executes and
     * resolves them natively, so the repository runs straight from source with no
     * build step: `node scripts/trace-check.ts`, `node src/server.ts`. TypeScript
     * is therefore a checker only — hence `noEmit`.
     *
     * Producing a `dist/` for deployment is a later, separate decision (ASM-013).
     */
    "allowImportingTsExtensions": true,
    "noEmit": true,

    "isolatedModules": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true
  }
}
