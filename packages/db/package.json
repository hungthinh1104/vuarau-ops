{
  "name": "@vuarau/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts",
    "./seeds": "./src/seeds/seed.ts"
  },
  "scripts": {
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=../../.env src/migrate.ts",
    "db:seed": "node --env-file-if-exists=../../.env src/seeds/seed.ts",
    "perf:production-scale": "node src/performance/production-scale-rehearsal.ts",
    "rehearse:migrations": "node src/performance/migration-rehearsal.ts"
  },
  "dependencies": {
    "@vuarau/domain-contracts": "workspace:*",
    "@vuarau/domain-kernel": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "postgres": "^3.4.7"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.6"
  }
}
